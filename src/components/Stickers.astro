---
// Tiny sprites that drop into place at the end of the intro, then drift around the hero stage.
// Only drawn when motion.ambient === "floaters".
import { config, assetExists } from '../lib/site';
import Placeholder from './Placeholder.astro';

const slots = [
  { x: '2%', y: '6%', s: 60, d: 7, r: -8 },
  { x: '84%', y: '4%', s: 54, d: 8.5, r: 10 },
  { x: '90%', y: '56%', s: 58, d: 6.5, r: -6 },
  { x: '-1%', y: '60%', s: 56, d: 9, r: 8 },
  { x: '46%', y: '92%', s: 50, d: 7.5, r: -10 },
  { x: '70%', y: '88%', s: 48, d: 8, r: 6 },
];
const kindOf = (src: string) => ['cherry', 'sprinkles', 'cupcake', 'donut', 'whisk'].find((k) => src.toLowerCase().includes(k)) ?? 'dot';
const list = config.brand.stickers.slice(0, slots.length);
---
{config.motion.ambient === 'floaters' && list.length > 0 && (
  <div class="stickers" aria-hidden="true">
    {list.map((src, i) => {
      const s = slots[i];
      return (
        <span class="sticker" style={`--x:${s.x};--y:${s.y};--s:${s.s}px;--dur:${s.d}s;--dl:${-i * 1.3}s;--r0:${s.r}deg;--r1:${-s.r}deg;--k:${i}`}>
          <span class="drop">
            {assetExists(src) ? <img src={src} alt="" width="160" height="160" decoding="async" /> : <Placeholder kind={kindOf(src)} />}
          </span>
        </span>
      );
    })}
  </div>
)}
