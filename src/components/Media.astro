---
// A real image if the processed file exists, otherwise a placeholder drawing. Never a broken image.
import { assetExists } from '../lib/site';
import Placeholder from './Placeholder.astro';

const { media, ph = 'cake', eager = false, class: cls = '' } = Astro.props;
const has = assetExists(media.src);
const classes = `media mask-${media.mask ?? 'none'} ${cls}`;
---
{has ? (
  <img
    class={classes}
    src={media.src}
    alt={media.decorative ? '' : media.alt}
    width={media.width}
    height={media.height}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
  />
) : (
  <Placeholder kind={ph} label={media.decorative ? '' : media.alt} class={classes} />
)}
