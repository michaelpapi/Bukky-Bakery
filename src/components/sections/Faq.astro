---
import Section from '../Section.astro';
const { section } = Astro.props;
---
<Section section={section}>
  <div class="faq">
    {section.items.map((f: { q: string; a: string }, i: number) => (
      <details class="rv" style={`--i:${i}`}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</Section>
