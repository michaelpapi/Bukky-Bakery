---
import Section from '../Section.astro';
import Media from '../Media.astro';
const { section } = Astro.props;
---
<Section section={section}>
  <div class="story">
    <div class="copy rv">
      {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
      <h2>{section.headline}</h2>
      {section.paragraphs.map((p: string) => <p>{p}</p>)}
      {section.highlights.length > 0 && (
        <ul class="highlights">
          {section.highlights.map((h: { value: string; label: string }) => <li><strong>{h.value}</strong><span>{h.label}</span></li>)}
        </ul>
      )}
    </div>
    {section.media && <div class="pic rv" style="--i:1"><Media media={section.media} ph="photo" /></div>}
  </div>
</Section>
